<?xml version="1.0" encoding="utf-8"?>
<!--
  R2PHARMA WhatsApp Bridge — IIS + Application Request Routing
  Copie para web.config no diretório físico do site IIS.
  Pré-requisitos: IIS URL Rewrite e ARR com proxy habilitado.
  O serviço Node escuta somente em 127.0.0.1:3002.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="R2PHARMA WhatsApp Bridge reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3002/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering allowDoubleEscaping="false">
        <!-- 150 MiB, alinhado ao limite JSON do serviço Node. -->
        <requestLimits maxAllowedContentLength="157286400" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
