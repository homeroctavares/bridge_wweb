# Copie para /etc/nginx/sites-available/r2pharma-whatsapp-bridge.conf
# Troque o server_name e os caminhos dos certificados pelos valores do cliente.
# O serviço Node permanece ligado somente em 127.0.0.1:3002.

server {
    listen 80;
    server_name whatsapp-bridge.r2pharma.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name whatsapp-bridge.r2pharma.example;

    ssl_certificate /etc/letsencrypt/live/whatsapp-bridge.r2pharma.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/whatsapp-bridge.r2pharma.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 16k;
    proxy_http_version 1.1;
    proxy_read_timeout 30s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_pass http://127.0.0.1:3002;
}
